-- 2. Insert Mapping Rules
-- Maps product keywords to package types for auto-selection
-- =============================================
INSERT INTO "PackageMappingRules" ("PackageTypeID", "Keyword", "MatchType", "Priority", "IsActive", "CreatedOn", "CreatedBy")
SELECT pt."PackageTypeID", rules."Keyword", 'Contains', rules."Priority", TRUE, NOW(), 'System'
FROM "PackageTypes" pt
JOIN (VALUES
    ('Medium Cake Box',     'Single Tier Cake', 10),
    ('Medium Cake Box',     '2 Tier Cake',      10),
    ('Medium Cake Box',     '3 Tier Cake',      10),
    ('Small Cake Box',      'Cupcake',           20),
    ('Cookie Box of 6',     'Brownie',           30),
    ('Cookie Box of 6',     'Macaron',           30),
    ('Medium Cheesecake Box','Cheesecake',       40),
    ('Deli Cake Box',       'Deli Cake',         50),
    ('Lunchbox Cake Box',   'Lunchbox',          60),
    ('Cake Tasting Box',    'Cake Tasting',      70),
    ('Custom Dessert Box',  'Platter',           80),
    ('Cookie Box of 6',     'Pastry',            90),
    ('Cookie Box of 6',     'Pasteries',         90),
    ('Cookie Box of 6',     'Doughnut',          100)
) AS rules("PackageName", "Keyword", "Priority")
ON pt."Name" = rules."PackageName"
WHERE pt."StoreID" = {STORE_ID};

-- =============================================
-- 3. Verify
-- =============================================
SELECT pt."Name", pt."LengthCm", pt."WidthCm", pt."HeightCm", pt."DefaultWeightKg", pt."IsDefault"
FROM "PackageTypes" pt
WHERE pt."StoreID" = {STORE_ID}
ORDER BY pt."SortOrder";

SELECT pt."Name" AS "PackageType", pmr."Keyword", pmr."Priority"
FROM "PackageMappingRules" pmr
JOIN "PackageTypes" pt ON pmr."PackageTypeID" = pt."PackageTypeID"
WHERE pt."StoreID" = {STORE_ID}
ORDER BY pmr."Priority";
