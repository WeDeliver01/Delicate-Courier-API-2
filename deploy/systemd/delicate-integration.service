[Unit]
Description=Delicate Couriers Integration Service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=delicate
WorkingDirectory=/opt/delicate/integration
ExecStart=/usr/bin/dotnet /opt/delicate/integration/DelicateCouriers.Integration.dll
EnvironmentFile=/etc/delicate/integration.env
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:8096
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=delicate-integration

[Install]
WantedBy=multi-user.target
